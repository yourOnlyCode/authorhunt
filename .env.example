# Author Hunt's environment. Copy to .env.local. Every value is optional in
# development: with none set, the app runs on a local database with sample
# data and sample sign-in. docs/setup-checklist.md says where each comes from.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres, the pooled connection string. Unset: a local database in .data/.
DATABASE_URL=

# Clerk: Author Hunt's own application, not Lorec's. Unset: sample accounts at /sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Stripe (Lorec's account, a restricted key). Unset: the pricing page explains, and nothing is charged.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Resend. Unset: emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Author Hunt <hello@authorhunt.com>"
# A postal address for the foot of the Sunday letter. US law asks for one in bulk mail.
EMAIL_POSTAL_ADDRESS=
# Where a banned or suspended person is told to write.
REPORTS_EMAIL=reports@authorhunt.com

# Upstash rate limits. Unset: limits are kept in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob for images. Unset: uploads are saved under public/uploads.
BLOB_READ_WRITE_TOKEN=

# Scheduled jobs call /api/cron/* with this as a bearer token.
CRON_SECRET=

# Comma-separated emails that see the admin pages.
ADMIN_EMAILS=

# When the site opens. While this is in the future every page shows the splash.
# Noon Eastern on January 8, 2027 is 2027-01-08T17:00:00Z. Unset: the site is open.
LAUNCH_AT=
# Lets you see the real site before opening: visit /?preview=<this value> once.
PREVIEW_SECRET=

# Early access: before opening, let authors set up their page and first launch at /start (docs/launch-plan.md,
# Part 1.5). Needs Clerk, Vercel Blob and the migrations in place first. Leave unset to keep it switched off.
EARLY_ACCESS=

# The ad pixels for the waitlist ads (components/analytics/ad-pixels.tsx). Unset uses the ids in that file; "off" removes one.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_OPENAI_PIXEL_ID=
