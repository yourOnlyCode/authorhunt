# Author Hunt's environment. Copy to .env.local. Every value is optional in
# development: with none set, the app runs on a local database with sample
# data and sample sign-in. docs/setup-checklist.md says where each comes from.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres, the pooled connection string. Unset: a local database in .data/.
DATABASE_URL=

# Clerk (Lorec's instance; authorhunt.com is a satellite). Unset: sample accounts at /sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Satellite settings, as named in Clerk's satellite-domain guide:
# NEXT_PUBLIC_CLERK_IS_SATELLITE=true
# NEXT_PUBLIC_CLERK_DOMAIN=authorhunt.com
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://lorec.io/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://lorec.io/sign-up

# Stripe (Lorec's account, a restricted key). Unset: the pricing page explains, and nothing is charged.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Resend. Unset: emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Author Hunt <hello@authorhunt.com>"

# Upstash rate limits. Unset: limits are kept in memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob for images. Unset: uploads are saved under public/uploads.
BLOB_READ_WRITE_TOKEN=

# Scheduled jobs call /api/cron/* with this as a bearer token.
CRON_SECRET=

# Comma-separated emails that see the admin pages.
ADMIN_EMAILS=

# When the site opens. While this is in the future every page shows the splash.
# Midnight Eastern on January 8, 2027. Unset: the site is open.
LAUNCH_AT=
# Lets you see the real site before opening: visit /?preview=<this value> once.
PREVIEW_SECRET=
